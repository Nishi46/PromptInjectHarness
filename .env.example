# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Free-tier signup links and binding constraints are in documentation/sprint_planning.md Appendix A.3.

# Google AI Studio (Gemini) — https://aistudio.google.com/app/apikey
# Free tier: ~1,500 requests/day, no credit card required.
GOOGLE_AI_STUDIO_API_KEY=

# Groq — https://console.groq.com/keys
# Free tier: ~1,000 req/day, ~100K tokens/day (token cap binds first — budget ~30 episodes/day).
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
# Free tier: 30+ free models, ~50 req/day pre-credit — headline configs only.
OPENROUTER_API_KEY=

# Local Ollama server (agentdojo's `LOCAL` model provider expects an
# OpenAI-compatible server at http://localhost:$LOCAL_LLM_PORT/v1).
# Ollama serves this natively on 11434 — no separate proxy needed.
LOCAL_LLM_PORT=11434
